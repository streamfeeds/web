#EXTINF:-1 group-title="ARTE Concert - World" tvg-id="522502142" tvg-name="Celia Was Debütalbum Fasadé ist eine Liebeserklärung an die afrokaribische Kultur. Nun präsentiert die Musikerin aus Guadeloupe das Werk bei den Musikalischen Höhenflügen.<br/>From 13.05.2025 18:00" tvg-country="Germany" tvg-language="German" channel-id="ARTE.DE",Célia Wa - Musikalische Höhenflüge (Originalversion) (13.05.2025)
