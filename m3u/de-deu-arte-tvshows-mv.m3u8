#EXTINF:-1 group-title="ARTE Concert - Klassik" tvg-id="1505331953" tvg-name="Das Orchestre de Paris unter der Leitung von Klaus Mäkelä und die Pianistin Yuja Wang spielen gemeinsam in der Pariser Philharmonie. Auf dem Programm: Debussys Prélude à l'après-midi d'un faune und zwei von Yuja Wang interpretierte Klavierkonzerte von Ravel.<br/>From 23.03.2025 17:25" tvg-country="Germany" tvg-language="German" channel-id="ARTE.DE",Klaus Mäkelä dirigiert Ravel - Mit Yuja Wang & dem Orchestre de Paris (Originalversion) (23.03.2025)
