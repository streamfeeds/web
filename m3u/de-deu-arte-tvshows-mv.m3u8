#EXTINF:-1 group-title="ARTE Concert - Metal" tvg-id="109600450" tvg-name="Die tschechisch-deutsche Band Dymytry Paradox steht für modernen Metal mit massiver Bühnenpräsenz. Beim Metal Hammer Paradise 2025 entfesseln sie ein Soundgewitter aus Härte‚ Melodie und Emotion.<br/>From 15.12.2025 17:16" tvg-country="Germany" tvg-language="German" channel-id="ARTE.DE",Dymytry Paradox - Metal Hammer Paradise 2025 (Originalversion) (15.12.2025)
