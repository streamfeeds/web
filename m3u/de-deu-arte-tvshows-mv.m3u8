#EXTINF:-1 group-title="ARTE Concert - Electronic" tvg-id="233026639" tvg-name="Seine Suche nach der ultimativen Erfahrung‚ dem Moment der absoluten Präsenz und die Jahre der leidenschaftlichen Hingabe an sein Handwerk haben Chris Liebing zum Synonym für Techno gemacht.<br/>From 22.08.2024 18:00" tvg-country="Germany" tvg-language="German" channel-id="ARTE.DE",Chris Liebing - Zurich Street Parade 2024 (Originalversion) (22.08.2024)
