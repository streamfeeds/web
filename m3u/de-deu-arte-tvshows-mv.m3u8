#EXTINF:-1 group-title="ARTE Concert - Electronic" tvg-id="1294793779" tvg-name="Der griechische Tastenvirtuose Theodore‚ der sich am Klavier ebenso wohlfühlt wie am Synthesizer‚ öffnet sein musikalisches Universum für die Europavox Sessions.<br/>From 06.07.2022 19:00" tvg-country="Germany" tvg-language="German" channel-id="ARTE.DE",Theodore - Europavox Session 2022 (Originalversion) (06.07.2022)
