#EXTINF:-1 group-title="Seriale i filmy fabularne - Seriale" tvg-id="1243568900" tvg-name="Juaną zostaje rzeczniczką ruchu edukacji seksualnej w swoim nowym liceum. Dla Julii to zaproszenie do rywalizacji. Tymczasem podczas imprezy Juana poznaje Leandro. Pojawia się między nimi chemia.<br/>From 07.12.2021 03:00" tvg-country="Germany" tvg-language="Polish" channel-id="ARTE.PL",Dotknięta - Metr dwadzieścia (3/6) (Originalversion mit Untertitel) (07.12.2021)
